CONTROL_PLANE_TUNNEL_ID=tunnel_...
CONTROL_PLANE_API_KEY=sk-proj-...

# Official Figma Desktop MCP bridge. No OAuth app, client ID, or Figma token is required.
FIGMA_DESKTOP_MCP_URL=http://127.0.0.1:3845/mcp
FIGMA_DESKTOP_TIMEOUT_MS=30000

# Bruno Desktop MCP bridge. Keep remote access disabled unless you fully trust the network path.
BRUNO_DESKTOP_MCP_URL=http://127.0.0.1:3847/mcp
BRUNO_DESKTOP_AUTH_TOKEN=
BRUNO_DESKTOP_TIMEOUT_MS=120000
BRUNO_DESKTOP_ALLOW_REMOTE=0
