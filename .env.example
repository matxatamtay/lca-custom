CONTROL_PLANE_TUNNEL_ID=tunnel_...
CONTROL_PLANE_API_KEY=sk-proj-...

# LCA is direct-only. There is no delegated Codex/Hermes/sub-agent provider chain.
# Optional self-improvement tools are discovered locally and remain advisory/on-demand.
AST_GREP_BIN=
SEMGREP_BIN=
STRYKER_BIN=
RENOVATE_BIN=
RENOVATE_FEED_PATH=

# Optional OpenTelemetry export. Leave empty to keep all traces local and make zero OTLP network calls.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Official Figma Desktop MCP bridge. No OAuth app, client ID, or Figma token is required.
FIGMA_DESKTOP_MCP_URL=http://127.0.0.1:3845/mcp
FIGMA_DESKTOP_TIMEOUT_MS=30000

# Official hosted Figma MCP. OAuth state is stored locally with file mode 0600.
FIGMA_REMOTE_ENABLED=0
FIGMA_REMOTE_MCP_URL=https://mcp.figma.com/mcp
FIGMA_REMOTE_TIMEOUT_MS=60000
FIGMA_REMOTE_ALLOW_WRITE=0
FIGMA_REMOTE_CALLBACK_URL=
FIGMA_REMOTE_TOKEN_PATH=
# Optional credentials from an approved Figma MCP Catalog client registration.
FIGMA_REMOTE_CLIENT_ID=
FIGMA_REMOTE_CLIENT_SECRET=
# Optional ready-to-use transport token. OAuth is used when empty.
FIGMA_REMOTE_AUTH_TOKEN=

# Bruno Desktop collection-native MCP bridge. The bearer token is transport auth only.
BRUNO_DESKTOP_MCP_URL=http://127.0.0.1:3847/mcp
BRUNO_DESKTOP_AUTH_TOKEN=
BRUNO_DESKTOP_TIMEOUT_MS=120000
BRUNO_DESKTOP_ALLOW_REMOTE=0

# Local Penpot MCP bridge. Keep the endpoint token-free; store the generated user token separately.
PENPOT_MCP_URL=http://127.0.0.1:9001/mcp/stream
PENPOT_USER_TOKEN=
PENPOT_MCP_TIMEOUT_MS=120000
PENPOT_MCP_ALLOW_REMOTE=0

# Local @masonator/coolify-mcp stdio bridge. Create an API token in Coolify Settings → API.
COOLIFY_BASE_URL=https://coolify.example.com
COOLIFY_ACCESS_TOKEN=
COOLIFY_MCP_TIMEOUT_MS=120000
