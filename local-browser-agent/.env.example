# Local server
LBA_PORT=8791
# Persistent Browser MCP sidecar for the Browser MCP extension (defaults shown).
LBA_BROWSER_MCP_NPX_BIN=npx
LBA_BROWSER_MCP_SOURCE=@browsermcp/mcp@0.1.3
# LBA_MCP_AUTH_TOKEN=generate-a-long-random-token

# Default browser agent: browser-use/jev-ultrafast + Browser Harness.
# LCA already accepts JEV_API_TOKEN; TYPESAFE_API_KEY is the upstream name.
# JEV_API_TOKEN=
# TYPESAFE_API_KEY=

# Browser mode: auto = real Chrome first, isolated persistent headless Chrome fallback.
LBA_BROWSER_MODE=auto
LBA_BROWSER_CDP_PORT=9223
# LBA_BROWSER_PROFILE_DIR=/absolute/path/to/persistent-browser-profile
# LBA_BROWSER_CHROME_BIN=/absolute/path/to/chrome
# LBA_JEV_PYTHON=3.12

# Optional OpenAI Secure MCP Tunnel
CONTROL_PLANE_TUNNEL_ID=tunnel_...
CONTROL_PLANE_API_KEY=sk-proj-...
# TUNNEL_BIN=/absolute/path/to/tunnel-client
# OPENAI_ORGANIZATION=org_...
